# Copia este archivo a .env y llena los valores. Nunca subas .env a git.

PORT=3000

# Conexión a PostgreSQL (RDS o la misma EC2)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/cimamuebles
# Pon true si usas RDS u otro Postgres que exige SSL
DB_SSL=false

# Secreto para firmar los tokens de login (cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# URL base de las fotos en S3 (sin diagonal final). Para usar Front/Imagenes en local, pon /Imagenes
S3_BASE_URL=https://examencncyg.s3.us-east-2.amazonaws.com/Productos

# Carpeta del front que Express sirve (relativa a Backend/)
FRONT_DIR=../Front

# Solo si el front se sirve desde otro dominio (separa con comas)
CORS_ORIGIN=

# Usuario administrador que crea "npm run db:admin"
ADMIN_EMAIL=admin@cimamuebles.mx
ADMIN_PASSWORD=cambia-esta-contraseña
